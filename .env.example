# Perceptron Mk1.5, called directly. Get a key at https://platform.perceptron.inc/
PERCEPTRON_API_KEY=
PERCEPTRON_MODEL=perceptron-mk1.5

# How the clip is sent: auto (try inline, fall back to file upload), inline, or upload
PERCEPTRON_VIDEO_MODE=auto

# Optional emergency fallback. Leave BLANK to keep the app 100% Perceptron.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
